# Public URL of the site (used for Stripe redirects and secure cookies)
BASE_URL=http://localhost:3000
PORT=3000

# AI detection model — sign up at sightengine.com (Dashboard → API keys)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Payments — dashboard.stripe.com → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# Business knobs
FREE_CREDITS=5
FREE_ACCOUNTS_PER_IP_PER_DAY=2
VIDEO_COST=4
VIDEO_FRAMES=4
MAX_UPLOAD_MB=100
MAX_IMAGE_MB=20
DB_PATH=./data/app.db
